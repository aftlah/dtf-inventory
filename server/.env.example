PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dtf_inventory
# Wajib diganti: string acak panjang (minimal 16 karakter)
JWT_SECRET=ganti-dengan-string-acak-panjang
# (Opsional) Dipakai sekali oleh `npm run db:init` untuk membuat admin pertama. Kosongkan ADMIN_PASSWORD bila admin
# dimasukkan manual ke database (lihat `npm run hash-password`).
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# (Opsional) Kirim notifikasi staff ke channel Discord: pesanan/pengajuan baru, laporan masuk, stok menipis.
# Buat di Discord: Edit Channel -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# Isi 1 bila aplikasi berjalan di belakang proxy hosting (cPanel Node.js App, Cloudflare). Dipakai agar pembatas
# login membaca IP asli pengguna dan HTTPS terdeteksi. Biarkan kosong bila server diakses langsung tanpa proxy.
TRUST_PROXY=

# (Opsional) Alamat situs. Bila diisi, judul pesan Discord bisa diklik dan langsung membuka halaman terkait.
# Contoh: APP_URL=https://dtf-inventory.aftlah.my.id
APP_URL=
